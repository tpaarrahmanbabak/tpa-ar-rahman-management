import express from 'express';
import cors from 'cors';
import path from 'path';
import { fileURLToPath } from 'url';
import { db, initializeDatabase, run, get, all } from './database.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const app = express();
const PORT = process.env.PORT || 3000;

app.use(cors());
app.use(express.json({ limit: '2mb' }));
app.use(express.urlencoded({ extended: true }));

app.get('/api/health', async (_, res) => {
  res.json({ status: 'ok', message: 'TPA Ar-Rahman API ready' });
});

app.post('/api/login', async (req, res) => {
  try {
    const { username, password } = req.body || {};
    const user = await get(
      'SELECT id, username, name, role FROM users WHERE username = ? AND password = ?',
      [username, password]
    );

    if (!user) {
      return res.status(401).json({ message: 'ID atau password salah.' });
    }

    return res.json({ user });
  } catch (error) {
    return res.status(500).json({ message: 'Login gagal', error: error.message });
  }
});

app.get('/api/profile', async (_, res) => {
  try {
    const profile = await get('SELECT * FROM profile WHERE id = 1');
    res.json(profile || { message: 'Profil belum tersedia' });
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil profil', error: error.message });
  }
});

app.put('/api/profile', async (req, res) => {
  try {
    const body = req.body || {};
    await run(
      `UPDATE profile SET name = ?, address = ?, founded = ?, tagline = ?, history = ?, logo = ? WHERE id = 1`,
      [body.name, body.address, body.founded, body.tagline, body.history, body.logo]
    );
    res.json({ message: 'Profil berhasil disimpan' });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menyimpan profil', error: error.message });
  }
});

app.get('/api/users', async (_, res) => {
  try {
    const rows = await all('SELECT id, username, name, role FROM users ORDER BY id ASC');
    res.json(rows);
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil data akun', error: error.message });
  }
});

app.post('/api/users', async (req, res) => {
  try {
    const { username, password, name, role } = req.body || {};
    if (!username || !password || !name || !role) {
      return res.status(400).json({ message: 'Semua field akun wajib diisi.' });
    }

    const existing = await get('SELECT id FROM users WHERE username = ?', [username]);
    if (existing) {
      return res.status(409).json({ message: 'Username sudah terpakai.' });
    }

    const result = await run(
      `INSERT INTO users (username, password, name, role) VALUES (?, ?, ?, ?)`,
      [username, password, name, role]
    );

    res.status(201).json({ id: result.id, username, name, role });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menambah akun', error: error.message });
  }
});

app.delete('/api/users/:id', async (req, res) => {
  try {
    const { id } = req.params;
    await run('DELETE FROM users WHERE id = ?', [id]);
    res.json({ message: 'Akun berhasil dihapus' });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menghapus akun', error: error.message });
  }
});

app.get('/api/students', async (_, res) => {
  try {
    const rows = await all('SELECT * FROM students ORDER BY name ASC');
    res.json(rows);
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil data santri', error: error.message });
  }
});

app.post('/api/students', async (req, res) => {
  try {
    const body = req.body || {};
    const student = {
      id: body.id || `S-${String(Date.now()).slice(-5)}`,
      name: body.name,
      parent: body.parent,
      dob: body.dob,
      gender: body.gender,
      phone: body.phone,
      className: body.className,
    };

    await run(
      `INSERT INTO students (id, name, parent, dob, gender, phone, className)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [student.id, student.name, student.parent, student.dob, student.gender, student.phone, student.className]
    );

    res.status(201).json(student);
  } catch (error) {
    res.status(500).json({ message: 'Gagal menambahkan santri', error: error.message });
  }
});

app.delete('/api/students/:id', async (req, res) => {
  try {
    await run('DELETE FROM students WHERE id = ?', [req.params.id]);
    res.json({ message: 'Data santri berhasil dihapus' });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menghapus santri', error: error.message });
  }
});

app.get('/api/attendance', async (_, res) => {
  try {
    const rows = await all('SELECT * FROM attendance ORDER BY date DESC');
    res.json(rows);
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil absensi', error: error.message });
  }
});

app.post('/api/attendance', async (req, res) => {
  try {
    const { studentId, studentName, date, status } = req.body || {};
    const id = `A-${String(Date.now()).slice(-5)}`;
    await run(
      `INSERT INTO attendance (id, studentId, studentName, date, status)
       VALUES (?, ?, ?, ?, ?)`,
      [id, studentId, studentName, date, status]
    );
    res.status(201).json({ id, studentId, studentName, date, status });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menyimpan absensi', error: error.message });
  }
});

app.delete('/api/attendance/:id', async (req, res) => {
  try {
    await run('DELETE FROM attendance WHERE id = ?', [req.params.id]);
    res.json({ message: 'Absensi berhasil dihapus' });
  } catch (error) {
    res.status(500).json({ message: 'Gagal menghapus absensi', error: error.message });
  }
});

app.get('/api/assessments', async (_, res) => {
  try {
    const rows = await all('SELECT * FROM assessments ORDER BY studentName ASC');
    res.json(rows);
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil nilai UKT', error: error.message });
  }
});

app.post('/api/assessments', async (req, res) => {
  try {
    const assessment = req.body || {};
    const next = {
      id: assessment.id || `N-${String(Date.now()).slice(-5)}`,
      studentId: assessment.studentId,
      studentName: assessment.studentName,
      level: assessment.level,
      bacaan: Number(assessment.bacaan || 0),
      hafalan: Number(assessment.hafalan || 0),
      tauhid: Number(assessment.tauhid || 0),
      fiqih: Number(assessment.fiqih || 0),
    };

    const existing = await get('SELECT id FROM assessments WHERE studentId = ?', [next.studentId]);
    if (existing) {
      await run(
        `UPDATE assessments SET studentName = ?, level = ?, bacaan = ?, hafalan = ?, tauhid = ?, fiqih = ? WHERE studentId = ?`,
        [next.studentName, next.level, next.bacaan, next.hafalan, next.tauhid, next.fiqih, next.studentId]
      );
      return res.json({ ...next, id: existing.id });
    }

    await run(
      `INSERT INTO assessments (id, studentId, studentName, level, bacaan, hafalan, tauhid, fiqih)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
      [next.id, next.studentId, next.studentName, next.level, next.bacaan, next.hafalan, next.tauhid, next.fiqih]
    );

    res.status(201).json(next);
  } catch (error) {
    res.status(500).json({ message: 'Gagal menyimpan nilai UKT', error: error.message });
  }
});

app.get('/api/organization', async (_, res) => {
  try {
    const row = await get('SELECT teachers, board FROM organization WHERE id = 1');
    res.json({
      teachers: row ? JSON.parse(row.teachers || '[]') : [],
      board: row ? JSON.parse(row.board || '[]') : [],
    });
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil struktur organisasi', error: error.message });
  }
});

app.get('/api/dashboard', async (_, res) => {
  try {
    const students = await all('SELECT * FROM students');
    const attendance = await all('SELECT * FROM attendance');
    const assessments = await all('SELECT * FROM assessments');

    const average = assessments.length
      ? assessments.reduce((sum, assessment) => {
          const values = [assessment.bacaan, assessment.hafalan, assessment.tauhid, assessment.fiqih];
          return sum + (values.reduce((a, b) => a + Number(b || 0), 0) / values.length);
        }, 0) / assessments.length
      : 0;

    res.json({
      totalStudents: students.length,
      presentToday: attendance.filter((item) => item.status === 'Hadir').length,
      averageScore: Number(average.toFixed(1)),
      passedCount: assessments.filter((item) => {
        const values = [item.bacaan, item.hafalan, item.tauhid, item.fiqih];
        const avg = values.reduce((sum, value) => sum + Number(value || 0), 0) / values.length;
        return avg >= 75;
      }).length,
    });
  } catch (error) {
    res.status(500).json({ message: 'Gagal mengambil data dashboard', error: error.message });
  }
});

app.use(express.static(__dirname));

app.get(/^(?!\/api).*$/, (_, res) => {
  res.sendFile(path.join(__dirname, 'index.html'));
});

await initializeDatabase();

app.listen(PORT, () => {
  console.log(`TPA Ar-Rahman API running on http://localhost:${PORT}`);
});

process.on('SIGINT', () => {
  db.close(() => process.exit(0));
});
